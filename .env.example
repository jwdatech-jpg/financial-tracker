# Backend Environment Variables

# Database URL - use PostgreSQL for production
# For development: sqlite:///./financial_tracker.db
# For production: postgresql://user:password@localhost/dbname
DATABASE_URL=postgresql://user:password@localhost/financial_tracker

# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production-very-important

# JWT Algorithm
ALGORITHM=HS256

# Token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend URL for CORS
FRONTEND_URL=https://your-domain.vercel.app

# Optional: Add additional CORS origins if needed
# CORS_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com"]
